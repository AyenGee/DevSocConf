# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here   # server only, never exposed to client

# Public app URL (used to build confirm links, both in the exported CSVs
# and in the DB lookups the app does)
APP_BASE_URL=https://your-deployed-domain.com

# Event config
EVENT_SPOTS_TOTAL=105
EVENT_NAME="AI & Beyond Tech Conference 2026"
EVENT_DATE_LABEL="Saturday, 29 August 2026 · 11:00 – 15:00"
EVENT_VENUE="Wits Main Campus, WSS4"

# Batch 1 CSV to seed (used by scripts/seed-batch1.ts)
REGISTRATION_CSV_PATH=./scripts/registrations.csv

# NOTE: there is no email service configured here on purpose. This system
# does not send any email itself — it generates CSVs of invite links for
# you to send manually (see README). Tickets never need emailing at all:
# each person's own confirmation link doubles as their permanent ticket.
